{
  "name": "@jasonbelmonti/markdown-engine",
  "version": "0.1.0",
  "description": "Deterministic Markdown parsing and validation engine package.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonbelmonti/markdown-engine.git"
  },
  "bugs": {
    "url": "https://github.com/jasonbelmonti/markdown-engine/issues"
  },
  "homepage": "https://github.com/jasonbelmonti/markdown-engine#readme",
  "keywords": [
    "markdown",
    "gfm",
    "frontmatter",
    "validation",
    "diagnostics"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run \"--exclude=.worktrees/**\""
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "cmark-gfm": "^0.9.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.3"
  }
}
