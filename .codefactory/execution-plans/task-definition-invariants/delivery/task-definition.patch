index 0000000..4b35c4e
--- /dev/null
+++ b/skills/task-definition/tests/run-invariants.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Run every assertion through the ordinary Markdown Engine validate command."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+from invariant_cases import cases
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--engine', required=True)
+    parser.add_argument('--profile', type=Path, default=Path(__file__).parent.parent / 'profiles/task-definition.yaml')
+    parser.add_argument('--phase', choices=['shape', 'full'], default='full')
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    results = []
+    with tempfile.TemporaryDirectory(prefix='task-invariants-') as directory:
+        for case in cases():
+            if args.phase == 'shape' and case['phase'] != 'shape':
+                continue
+            source = case.pop('markdown')
+            path = Path(directory) / (case['name'] + '.md')
+            path.write_text(source)
+            process = subprocess.run([args.engine, 'validate', '--file', str(path), '--profile', str(args.profile), '--format', 'json'], capture_output=True, text=True)
+            report = json.loads(process.stdout)
+            diagnostics = report.get('diagnostics', [])
+            valid = report.get('valid')
+            matched = (valid == case['expectedValid'] and process.returncode == (0 if case['expectedValid'] else 1) and report.get('evidence', {}).get('engineVersion') is not None)
+            if case['expectedValid']:
+                matched = matched and not diagnostics
+            else:
+                matched = matched and any(d.get('ruleId') == case['rule'] and d.get('message') and d.get('code') for d in diagnostics)
+            results.append({**case, 'valid': valid, 'exitStatus': process.returncode, 'engineVersion': report.get('evidence', {}).get('engineVersion'), 'inputHash': hashlib.sha256(source.encode()).hexdigest(), 'profileHash': hashlib.sha256(args.profile.read_bytes()).hexdigest(), 'diagnostics': diagnostics, 'matchesExpectation': bool(matched)})
+    output = {'allMatched': all(case['matchesExpectation'] for case in results), 'cases': results}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(output, indent=2) + '\n')
+    failed = [case['name'] for case in results if not case['matchesExpectation']]
+    print(json.dumps({'count': len(results), 'failed': failed, 'output': str(args.output)}))
+    return int(bool(failed))
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
