+"""Contract mutations, kept separate from CLI execution and reporting."""
+from pathlib import Path
+
+FIXTURES = Path(__file__).parent / 'fixtures' / 'invariants'
+HEADERS = ['Execution status', 'Current proving slice', 'Evidence admitted', 'Next action', 'Blockers / stop condition']
+
+
+def cases():
+    base = (FIXTURES / 'baseline.md').read_text()
+    checkpoint = (FIXTURES / 'checkpoint-baseline.md').read_text()
+    table = checkpoint.split('### Execution Checkpoint\n', 1)[1].split('\n## ', 1)[0].strip()
+    control = base.split('## Task Control\n', 1)[1].split('\n## ', 1)[0].strip()
+    row = next(line for line in table.splitlines() if line.startswith('| active |'))
+    values = [part.strip() for part in row.strip('|').split('|')]
+
+    def cell(index, value, document=checkpoint):
+        parts = values.copy()
+        parts[index] = value
+        return document.replace(row, '| ' + ' | '.join(parts) + ' |')
+
+    def ready(evidence):
+        return cell(2, evidence).replace('| active |', '| review-ready |').replace(values[3], 'Request independent review.')
+
+    result = []
+    def add(name, document, valid=True, rule=None, phase='shape'):
+        result.append(dict(name=name, markdown=document, expectedValid=valid, rule=rule, phase=phase))
+
+    add('baseline', base)
+    add('checkpoint-baseline', checkpoint)
+    for name, rule in [('duplicate-control-row', 'task-control.row.count'), ('duplicate-checkpoint-row', 'execution-checkpoint.row.when-present'), ('invalid-checkpoint-status', 'execution-checkpoint.status.allowed'), ('review-ready-without-evidence', 'execution-checkpoint.required-evidence.coverage')]:
+        add(name, (FIXTURES / (name + '.md')).read_text(), False, rule, 'full' if name.startswith('review-ready') else 'shape')
+    add('control-zero-rows', base.replace(control.splitlines()[-1], ''), False, 'task-control.row.count')
+    add('control-duplicate-tables', base.replace(control, control + '\n\n' + control), False, 'task-control.table.count')
+    add('control-duplicate-section', base.replace('## Objective', '## Task Control\n\n' + control + '\n\n## Objective'), False, 'task-control.table.count')
+    add('control-table-elsewhere', base + '\n' + control + '\n', False, 'task-control.table.count')
+    add('checkpoint-zero-rows', checkpoint.replace(row, ''), False, 'execution-checkpoint.row.when-present')
+    add('checkpoint-no-table', checkpoint.replace(table, 'Resume work.'), False, 'execution-checkpoint.table.inside-checkpoint')
+    add('checkpoint-duplicate-tables', checkpoint.replace(table, table + '\n\n' + table), False, 'execution-checkpoint.table.global-count')
+    add('checkpoint-duplicate-headings', checkpoint.replace('### Execution Checkpoint', '### Execution Checkpoint\n\nEmpty.\n\n### Execution Checkpoint'), False, 'execution-checkpoint.heading.count')
+    add('checkpoint-heading-depth-two', checkpoint.replace('### Execution Checkpoint', '## Execution Checkpoint'), False, 'execution-checkpoint.heading-depth.when-present')
+    add('checkpoint-heading-depth-four', checkpoint.replace('### Execution Checkpoint', '#### Execution Checkpoint'), False, 'execution-checkpoint.heading-depth.when-present')
+    add('checkpoint-misplaced', checkpoint.replace('### Execution Checkpoint', '## Other Notes\n\n### Execution Checkpoint'), False, 'execution-checkpoint.table.when-present')
+    add('checkpoint-table-before-heading', checkpoint.replace('### Execution Checkpoint\n\n' + table, table + '\n\n### Execution Checkpoint\n\nResume.'), False, 'execution-checkpoint.table.inside-checkpoint')
+    add('checkpoint-table-without-heading', checkpoint.replace('### Execution Checkpoint\n', ''), False, 'execution-checkpoint.heading.when-table-present')
+    add('checkpoint-table-in-sibling', checkpoint.replace('### Execution Checkpoint', '### Execution Checkpoint\n\nResume.\n\n### Other'), False, 'execution-checkpoint.table.inside-checkpoint')
+    add('checkpoint-decoy-notes-table', checkpoint.replace('### Execution Checkpoint', table + '\n\n## Other Notes\n\n### Execution Checkpoint'), False, 'execution-checkpoint.table.global-count')
+    add('checkpoint-extra-table', checkpoint.replace(table, table + '\n\n| Other |\n| --- |\n| Value |'), False, 'execution-checkpoint.table.inside-checkpoint')
+    for status in ['not-started', 'active', 'blocked']:
+        doc = cell(0, status).replace(values[2], 'None admitted.')
+        if status == 'blocked':
+            doc = doc.replace(values[4], 'Build dependency unavailable; resume when restored.').replace(values[3], 'Restore build dependency.')
+        if status == 'not-started':
+            doc = doc.replace(values[3], 'Begin the current proving slice.')
+        add('status-' + status, doc)
+    for index in range(5):
+        for label, value in [('empty', ''), ('whitespace', '   \t '), ('comment', '<!-- hidden -->'), ('empty-html', '<span></span>'), ('html-whitespace', '<span> </span>'), ('nbsp', '&nbsp;')]:
+            add(f'cell-{index}-{label}', cell(index, value), False, 'execution-checkpoint.cells.nonblank', 'full')
+    for label, value in [('emphasis', '**Concrete next action.**'), ('code', '`<span></span>`'), ('html', '<span>Concrete next action.</span>'), ('escaped-html', '&lt;span&gt;'), ('comment-plus-text', '<!-- note --> Concrete next action.')]:
+        add('visible-' + label, cell(3, value), phase='full')
+    add('review-ready-complete', ready('TD-SC-1: focused test passed at commit abc123. TD-SC-2: artifact inspection passed at commit abc123.'), phase='full')
+    add('review-ready-formatted', ready('**TD-SC-1**: focused test passed. `TD-SC-2`: artifact inspection passed.'), phase='full')
+    add('review-ready-no-references', ready('Focused tests passed.'), False, 'execution-checkpoint.required-evidence.coverage', 'full')
+    add('review-ready-partial', ready('TD-SC-1: focused test passed.'), False, 'execution-checkpoint.required-evidence.coverage', 'full')
+    add('active-partial', cell(2, 'TD-SC-1: focused test passed.'), phase='full')
+    add('undeclared-active', cell(2, 'TD-SC-99: focused test passed.'), False, 'execution-checkpoint.evidence.declared', 'full')
+    add('undeclared-review-ready', ready('TD-SC-1 and TD-SC-2: focused tests passed. TD-SC-99: inspection passed.'), False, 'execution-checkpoint.evidence.declared', 'full')
+    add('review-ready-id-only-next-action', ready('TD-SC-1: focused test passed.').replace('Request independent review.', 'TD-SC-2: request independent review.'), False, 'execution-checkpoint.required-evidence.coverage', 'full')
+    add('review-ready-id-only-validation', ready('TD-SC-1: focused test passed.'), False, 'execution-checkpoint.required-evidence.coverage', 'full')
+    criteria = base.split('## Materially Verifiable Success Criteria\n', 1)[1].split('\n## ', 1)[0]
+    lines = criteria.splitlines()
+    optional = '\n'.join(line.removesuffix('Yes |') + 'No |' if line.startswith('| TD-SC-2 ') else line for line in lines)
+    add('review-ready-optional-criterion', ready('TD-SC-1: focused test passed.').replace(criteria, optional), phase='full')
+    add('review-ready-all-optional', ready('None admitted.').replace(criteria, criteria.replace('| Yes |', '| No |')), phase='full')
+    add('review-ready-required-second', ready('TD-SC-1: focused test passed.').replace(criteria, '\n'.join(line.removesuffix('Yes |') + 'No |' if line.startswith('| TD-SC-1 ') else line for line in lines)), False, 'execution-checkpoint.required-evidence.coverage', 'full')
+    add('review-ready-formatted-required', ready('TD-SC-1: focused test passed.').replace(criteria, criteria.replace('| Yes |', '| **Yes** |')), False, 'execution-checkpoint.required-evidence.coverage', 'full')
+    # Renamed declared IDs prevent hardcoded enumeration from satisfying the contract.
+    add('review-ready-renamed-id', ready('TD-SC-1: focused test passed. TD-SC-2: inspection passed.').replace('TD-SC-2', 'TD-SC-A'), phase='full')
+    add('control-duplicate-empty-section', base.replace('## Objective', '### Task Control\n\n## Objective'), False, 'task-control.heading.count')
+    add('checkpoint-duplicate-notes-decoy', checkpoint.replace('### Execution Checkpoint', '## Execution Notes\n\n### Execution Checkpoint'), False, 'execution-checkpoint.notes.count')
+    add('active-evidence-without-reference', cell(2, 'Focused tests passed.'), False, 'execution-checkpoint.evidence.references-or-none', 'full')
+    add('active-wrong-evidence-sentinel', cell(2, 'None.'), False, 'execution-checkpoint.evidence.references-or-none', 'full')
+    return result
diff --git a/skills/task-definition/tests/run-invariants.py b/skills/task-definition/tests/run-invariants.py
